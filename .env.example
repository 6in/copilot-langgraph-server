# .env.example — 開発環境セットアップ用テンプレート
# このファイルをコピーして .env を作成し、各値を設定してください。
# cp .env.example .env

# Vite アプリのベースパス（nginx リバースプロキシのプレフィックスに合わせる）
VITE_APP_BASE=/orochi

# Tavily API キー（web_search ツールに使用）
# 取得先: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# ─── HTTP プロキシ設定 (任意) ───────────────────────────────────
# プロキシ配下の環境にデプロイする場合のみ、以下 3 つをコメントアウト解除して設定。
# 未設定なら空文字として扱われ、直接インターネット接続される (=従来動作)。
#
# 設定対象:
#   - build 時: bun install / apt-get / curl / npm install
#   - runtime 時: uv sync (依存ダウンロード) / httpx / Tavily SDK / Copilot SDK バイナリ
#     (undici EnvHttpProxyAgent 経由で GitHub Copilot エンドポイントへの通信)
#
# NO_PROXY には Docker 内部の service 名を必ず含めること
# (内部通信が proxy 経由になると localhost 解決に失敗する)。compose 側にデフォルト値があるため
# NO_PROXY 自体は省略可だが、社内固有の内部 IP/ホストを足したい場合はここで明示的に上書きする。
#
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis,mcp-server,api,frontend,worker,nginx

# ─── JWT シークレット (開発用) ───────────────────────────────────
# HS256 用の署名キー。32 バイト (= hex 64 文字) 以上のランダム値を設定する。
# 未設定の場合は app/auth/jwt_utils.py が ~/.copilot_sdk/.jwt_secret に自動生成・永続化する
# (Docker 環境ではボリュームに残らないので env 経由で明示指定するのを推奨)。
#
# 値の生成コマンド:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 本番では必ず新しい値に差し替えること。
JWT_SECRET=47e97d9c9096860207a846d5d8697d56b68e53b88bf74418611373e7c604ab31
